#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufA {
    uint values_a[];
};
layout(std430, binding = 1) readonly buffer BufB {
    uint values_b[];
};
layout(std430, binding = 2) writeonly buffer BufC {
    uint values_c[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    values_c[i] = values_a[i] + values_b[i];
}
